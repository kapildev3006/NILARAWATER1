# ==============================================================================
# NILARA BACKEND - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# Server Port (Render sets this dynamically)
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nilara?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here_nilara_2026

# Cloudinary (Image & Document Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins (Comma-separated or *)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-admin-domain.com

# Firebase Service Account (For Render / Production deployment)
# Paste the entire single-line raw JSON string from firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
